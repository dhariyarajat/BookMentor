# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mentor_booking
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.xxxxx.mongodb.net/mentor_booking

# ---- JWT ----
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- Frontend ----
CLIENT_URL=http://localhost:5173

# ---- Google OAuth (from Google Cloud Console) ----
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Comma separated emails that will become admins on signup
ADMIN_EMAILS=admin@example.com

# If true, new mentors are approved automatically. If false, an admin must approve them.
AUTO_APPROVE_MENTORS=true

# ---- Email (Nodemailer - use Gmail app password or any SMTP) ----
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="MentorBook <you@gmail.com>"

# ---- Timezone used for slot computations ----
TZ=Asia/Kolkata
